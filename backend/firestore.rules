rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read their own profile; mechanics' public info is readable
    // by anyone signed in (needed for job matching).
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Jobs: motorist who created it and the assigned mechanic can read/write.
    // Any signed-in mechanic can read open ("requested") jobs to accept one.
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.motoristId == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Vehicles: only the owner can read/write their vehicle's data.
    match /vehicles/{vehicleId} {
      allow read, write: if request.auth != null
                          && resource.data.ownerId == request.auth.uid;
    }

    // Alerts: motorist can create; readable by signed-in users
    // (the mock dispatch screen needs to see incoming alerts).
    match /alerts/{alertId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.motoristId == request.auth.uid;
      allow update: if request.auth != null;
    }
  }
}
